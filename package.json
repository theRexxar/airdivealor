{
  "name": "airdivealor-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "cms:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "cms:check": "tsx scripts/check-defaults.ts",
    "cms:defaults": "tsx scripts/gen-home-defaults.ts && tsx scripts/gen-dive-sites-defaults.ts && tsx scripts/gen-facilities-defaults.ts && tsx scripts/gen-courses-defaults.ts && tsx scripts/gen-about-defaults.ts && tsx scripts/gen-blog-defaults.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.3",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.6",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
