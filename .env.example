# Public site URL (links in emails)
SITE_URL=http://localhost:3000
# Where the website calls the CMS API for Home content. Leave empty to use this same app.
CMS_API_URL=

# MySQL
DATABASE_URL=mysql://airdive:airdive@127.0.0.1:3306/airdivealor

# Redis (BullMQ upload queue)
REDIS_URL=redis://127.0.0.1:6379

# MinIO / S3
S3_ENDPOINT=http://127.0.0.1:9000
# Address browsers use for direct uploads, if the server reaches MinIO on an internal hostname. Leave empty otherwise.
S3_UPLOAD_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=airdivealor-media
# Public base URL for processed media (bucket path is appended). Point this at a CDN in production.
S3_PUBLIC_URL=http://127.0.0.1:9000/airdivealor-media

# Brevo transactional email (forgot password, invitations). Without a key, emails are printed to the server log.
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@airdivealor.com
MAIL_FROM_NAME="Air Dive Alor"

# First admin, created by `npm run cms:seed`
SEED_ADMIN_EMAIL=admin@airdivealor.com
SEED_ADMIN_PASSWORD=change-me-now
